numbers = [10, 20, 30, 40, 50, 60, 70]
target = 36
def closest_number(numbers, low, high):
    for i in range(len(numbers)-1):
        mid = (low + high) // 2
        if numbers[mid] == target:
            return numbers[mid]
        elif numbers[mid] < target:
            low = mid + 1
        else:
            high = mid -1 
    if low >= len(numbers):
        return numbers[-1]
    if high < 0:
        return numbers[0]
    if target - numbers[high] <= numbers[low] - target:
        return numbers[high]
    else:
        return numbers[low]
    
print(closest_number(numbers, 0, len(numbers)))

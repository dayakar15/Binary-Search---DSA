numbers = [10, 20, 30, 40, 50, 60, 70]
target = 46
def floor_number(numbers, low, high):
    for i in range(len(numbers) -1):
        mid = (low + high) // 2
        if numbers[mid] == target:
            return mid
        elif numbers[mid] <= target:
            answer = numbers[mid]
            low = mid + 1
        else:
            high = mid - 1
    return answer
            
        

print(floor_number(numbers, 0, len(numbers)-1))
        

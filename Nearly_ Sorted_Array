numbers = [10, 20, 30, 50, 40, 60, 70]
target = 40
def Nearly_Sorted_Array(numbers, low, high):
    for i in range(len(numbers)):
        mid = (low + high) // 2
        if numbers[mid] == target:
            return mid
        if mid > 0 and numbers[mid - 1] == target:
            return numbers[mid - 1]
        if mid < len(numbers) - 1 and numbers[mid + 1] == target:
            return mid + 1
        if numbers[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
print(Nearly_Sorted_Array(numbers, 0, len(numbers)))
